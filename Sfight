const { bot, getRandom, jidToNum } = require('../lib/')

bot(
  {
    pattern: 'fight ?(.*)',
    fromMe: true,
    desc: 'random fight ',
    type: 'fun',
  },
  async (message, match) => {
    let a = message.reply_message.jid || message.mention[0]
    const b = message.participant
    if (!a) {
      const p = await message.groupMetadata(message.jid)
      a = getRandom(p).id
    }

    const caption = `@${jidToNum(b)} 𝐕𝐒 @${jidToNum(a)}
             
      return await message.sendFromUrl('https://files.catbox.moe/5kac47.mp4', {
      caption,
      contextInfo: { mentionedJid: [b, a] },
      gifPlayback: true,
    })
  }
)
